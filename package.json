{
  "name": "yohdev-website-refresh",
  "version": "0.1.0",
  "description": "YohDev Website Playbook - AI-assisted, multi-skill website build system",
  "main": ".claude/skills/yohdev-website-refresh/run-skill.js",
  "scripts": {
    "skill": "node .claude/skills/yohdev-website-refresh/run-skill.js",
    "screenshot": "bash .claude/skills/yohdev-website-refresh/scripts/screenshot-current-site.sh",
    "state": "node .claude/skills/yohdev-website-refresh/scripts/state-manager.js",
    "state:status": "node .claude/skills/yohdev-website-refresh/scripts/state-manager.js status",
    "state:reset": "node .claude/skills/yohdev-website-refresh/scripts/state-manager.js reset",
    "phase:01": "echo 'Starting Phase 01 - Intake' && node .claude/skills/yohdev-website-refresh/scripts/state-manager.js start-phase 1",
    "phase:02": "echo 'Starting Phase 02 - Research' && node .claude/skills/yohdev-website-refresh/scripts/state-manager.js start-phase 2",
    "phase:03": "echo 'Starting Phase 03 - System' && node .claude/skills/yohdev-website-refresh/scripts/state-manager.js start-phase 3",
    "phase:04": "echo 'Starting Phase 04 - Home Page' && node .claude/skills/yohdev-website-refresh/scripts/state-manager.js start-phase 4",
    "phase:05": "echo 'Starting Phase 05 - Style Guide' && node .claude/skills/yohdev-website-refresh/scripts/state-manager.js start-phase 5",
    "phase:06": "echo 'Starting Phase 06 - Package' && node .claude/skills/yohdev-website-refresh/scripts/state-manager.js start-phase 6",
    "continue": "node .claude/skills/yohdev-website-refresh/scripts/state-manager.js next-phase && npm run skill",
    "build": "bash scripts/build.sh",
    "serve": "bash scripts/serve.sh",
    "deploy:preview": "npm run build && npx surge ./dist --domain yd-playbook-preview.surge.sh",
    "figma:tokens": "node scripts/figma-tokens.js",
    "figma:diff": "node scripts/figma-diff.js",
    "figma:shot": "bash scripts/page-shot.sh",
    "figma:lock": "node scripts/figma-tokens.js --init-lock",
    "figma:check": "node scripts/figma-tokens.js --check",
    "ada:scan": "node scripts/ada-scan.js",
    "ada:scan:staged": "node scripts/ada-scan.js --staged",
    "structure:scan": "node scripts/structure-scan.js",
    "structure:scan:staged": "node scripts/structure-scan.js --staged",
    "structure:fix": "node scripts/structure-scan.js --fix",
    "craft:scan": "node scripts/craft-scan.js",
    "craft:scan:staged": "node scripts/craft-scan.js --staged",
    "images:generate": "node scripts/generate-images.mjs",
    "images:dry-run": "node scripts/generate-images.mjs --dry-run",
    "concepts:check": "node scripts/concept-directions.mjs",
    "logos": "node scripts/logo-selection/build.js",
    "logos:check": "node scripts/logo-selection/check.js",
    "logos:designs": "node scripts/logo-selection/designs.js",
    "logos:fonts": "node scripts/logo-selection/fonts.js",
    "logos:marks": "node scripts/logo-selection/marks.js",
    "logos:trace": "node scripts/logo-selection/trace.js",
    "logos:small": "node scripts/logo-selection/small-mark.js",
    "logos:ada": "node scripts/ada-scan.js demos/rodwell-tuohy/logo-selection.html demos/rodwell-tuohy/logo-selection-a.html demos/rodwell-tuohy/logo-selection-b.html demos/rodwell-tuohy/logo-selection-visid-a.html demos/rodwell-tuohy/logo-selection-visid-b.html",
    "deck:art": "node scripts/decks/render-art.js",
    "deck:solas": "node scripts/decks/solas-visid.js",
    "install-hook": "git config core.hooksPath .githooks && echo 'Pre-commit gate installed (ADA + structure) (core.hooksPath=.githooks)'",
    "ada:install-hook": "git config core.hooksPath .githooks && echo 'Pre-commit gate installed (ADA + structure) (core.hooksPath=.githooks)'",
    "kit:init": "node scripts/logo-asset-kit/init.js",
    "kit": "node scripts/logo-asset-kit/build.js",
    "kit:check": "node scripts/logo-asset-kit/check.js",
    "brochure": "node demos/tripos/brochures/build.js",
    "brochure:all": "node demos/tripos/brochures/build.js --all",
    "brochure:intake": "node demos/tripos/brochures/intake.js"
  },
  "keywords": [
    "yohdev",
    "website",
    "refresh",
    "playbook",
    "claude",
    "skill"
  ],
  "author": "YohDev",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "pptxgenjs": "^4.0.1"
  }
}
